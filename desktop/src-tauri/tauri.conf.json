{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora",
  "version": "0.11.245",
  "identifier": "it.aurora.station",
  "build": {
    "frontendDist": "../stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../app/dist": "dist",
      "hamlib-bundle": "hamlib",
      "cty": "cty",
      "demo-sstv": "demo-sstv"
    },
    "publisher": "Tiziano Cassone (IU3WJQ)",
    "copyright": "© 2026 Tiziano Cassone (IU3WJQ) — GNU GPL 3.0",
    "homepage": "https://github.com/wifi75/Aurora",
    "category": "Utility",
    "shortDescription": "Aurora — Multimode Ham Radio Station",
    "longDescription": "Aurora è una stazione radioamatoriale multimodo (FT8, FT4, JT65, JT9, JT4, Q65, MSK144, PSK, RTTY, CW, SSTV, satelliti) con un motore proprio di decodifica e trasmissione, automazione dei QSO e controllo da telefono. Funziona da sola, senza altri programmi.",
    "licenseFile": "../../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian", "English", "German", "French", "Spanish", "Portuguese", "Dutch"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh",
        "template": "installer/installer.nsi",
        "startMenuFolder": "Aurora"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3NEMzRDk5MTIyQ0E0OTIKUldTU3BDd1NtVDFNSjRYT0VUcy8zRDJ2Z2xwVVpEZWsvaElNN1JjaUNBR002WDFLR3NDUFAwaHMK",
      "endpoints": []
    }
  }
}
