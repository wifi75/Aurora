mult=dxcc/band/if:my_cont:AS; wpx/band/if:my_cont:EU,AF,NA,SA,OC

[Script]
// gli asiatici lavorano tutti tranne il proprio paese, gli altri solo l'Asia
fn ammesso(qso) {
    if qso.my_cont == "AS" {
        if qso.dxcc == qso.my_dxcc { [false, "valid"] } else { true }
    } else if qso.cont == "AS" { true } else { [false, "valid"] }
}
