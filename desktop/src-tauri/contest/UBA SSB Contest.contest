[Script]
// stazioni fuori dal Belgio: bonus = punti dei QSO con il Belgio x la loro percentuale sui QSO validi (per difetto),
// sommato ai punti prima dei moltiplicatori (esempio del regolamento: 50 QSO ON di 320, 500 punti -> 78)
fn punteggio(t) {
    if t.my_dxcc == "ON" || t.qso == 0 || !("ON" in t.paesi) { return t.punti * t.molt; }
    let on = t.paesi["ON"];
    (t.punti + on.punti * on.qso / t.qso) * t.molt
}
