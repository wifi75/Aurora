[Contest]
m_sName=TRC DIGI Contest
m_sNotes=RTTY PSK; i soci aggiungono TRC al numero (scambio in m_sNrs)
m_dtStart=
m_dtEnd=
m_iWorkTime=0
m_sNrs=
n_bAutoIncNrs=1
m_iValidContacts=0
m_bValidCw=0
m_bValidPhone=0
m_bValidDigital=1
m_iPointsMyDxcc=0
m_iPointsMyCont=0
m_iPointsDx=0
m_iMultipliers=0
m_iMultipliersOption=0
m_bBandMult=0
m_bBand160Mult=0
m_iBand160Mult=0
m_bBand80Mult=0
m_iBand80Mult=0
m_bBand40Mult=0
m_iBand40Mult=0
m_bBand20Mult=0
m_iBand20Mult=0
m_bBand15Mult=0
m_iBand15Mult=0
m_bBand10Mult=0
m_iBand10Mult=0
m_sMacrosFilename=macros/TRC DIGI Contest.mc
m_bMergeMacros=1
m_bAutoGrabNumber=1
m_iGrabNumberType=0
m_bAutoGrabTime=0
m_bAutoGrabState=0
m_sStateListFile=
m_iGrabDomainTo=1
m_bSuggestCqZone=0
m_bSuggestItuZone=0
m_bSuggestDomain=0
m_bSuggestDxccPfx=0
m_bDupeNoBand=0
m_bDupeNoMode=0
m_iLogBarDispMode=1
[Score]
bands=160,80,40,20,15,10
valid=mode:RTTY
points=same_cont=1; any=2
[Script]
// TRC: 10 punti con una stazione TRC (scambio con TRC), 1 fra due soci; paesi DXCC e paesi TRC per banda
fn trc(s) { s.to_upper().contains("TRC") }
fn punti(qso) {
    let suo = trc(qso.exch_rcvd);
    if suo && trc(qso.exch_sent) { 1 } else if suo { 10 } else if qso.cont != "" && qso.cont == qso.my_cont { 1 } else { 2 }
}
fn moltiplicatori(qso) {
    let k = [];
    if qso.dxcc != "" {
        k.push("dxcc:" + qso.dxcc + "@" + qso.band);
        if trc(qso.exch_rcvd) { k.push("trc:" + qso.dxcc + "@" + qso.band); }
    }
    k
}
