[Script]
// moltiplicatore: le ultime due cifre dell'anno della prima licenza, una volta per banda in qualsiasi modo
fn moltiplicatori(qso) {
    let s = qso.exch_rcvd; s.trim(); let p = s.split(" ");
    let w = p[p.len() - 1];
    if w == "" { [] } else { ["anno:" + w + "@" + qso.band] }
}
