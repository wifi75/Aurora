mult=itu/band

[Script]
// zona ITU dallo scambio; una sigla (ARRL, DARC, R1, AC...) e' una stazione HQ o un ufficiale IARU
fn cifre(s) { if s == "" { return false; } for ch in s { if ch < '0' || ch > '9' { return false; } } true }
fn ultima(qso) { let u = ""; for w in qso.exch_rcvd.split(" ") { if w != "" { u = w.to_upper(); } } u }
fn zona(qso) { let w = ultima(qso); if w == "" { qso.itu } else if cifre(w) { parse_int(w) } else { -1 } }
fn punti(qso) {
    let z = zona(qso);
    if z < 0 { 1 } else if z == qso.my_itu { 1 } else if qso.cont != "" && qso.cont == qso.my_cont { 3 } else { 5 }
}
fn moltiplicatori(qso) {
    let z = zona(qso);
    if z < 0 { ["hq:" + ultima(qso) + "@" + qso.band] } else if z > 0 { ["itu:" + z + "@" + qso.band] } else { [] }
}
