# Porta UDP su cui Aurora ascolta JTDX (Impostazioni > Reporting in JTDX)
AURORA_UDP_PORT=2237

# Server di Aurora
AURORA_BIND=127.0.0.1:8787
AURORA_DATA_DIR=data
# Cartella dell'interfaccia compilata (vuoto in sviluppo: la serve Vite)
AURORA_UI_DIR=
# Motore: per ora solo "sim" (stazione simulata)
AURORA_ENGINE=sim
AURORA_SIM_CYCLE_MS=15000
# Cookie con attributo Secure: metti 1 quando si arriva in HTTPS (Tailscale serve, Cloudflare)
AURORA_SECURE_COOKIE=0
