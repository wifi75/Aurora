# Porta UDP su cui Aurora ascolta JTDX (Impostazioni > Reporting in JTDX)
AURORA_UDP_PORT=2237

# Server di Aurora
AURORA_BIND=127.0.0.1:8787
AURORA_DATA_DIR=data
# Cartella dell'interfaccia compilata (vuoto in sviluppo: la serve Vite)
AURORA_UI_DIR=
# Motore: "sim" (stazione simulata) oppure "jtdx" (JTDX reale tramite l'hub UDP)
AURORA_ENGINE=sim
AURORA_SIM_CYCLE_MS=15000
# Cookie con attributo Secure: metti 1 quando si arriva in HTTPS (Tailscale serve, Cloudflare)
AURORA_SECURE_COOKIE=0

# Solo con AURORA_ENGINE=jtdx
# Dove l'hub ascolta il flusso di JTDX: nelle impostazioni di JTDX il server UDP primario va puntato qui
AURORA_UDP_LISTEN=127.0.0.1:2334
# A chi inoltrare il flusso identico, separati da virgole (GridTracker2 ascolta su 127.0.0.1:2333)
AURORA_UDP_FORWARD=127.0.0.1:2333

# Cascata dall'ingresso audio (parte del nome, senza distinzione di maiuscole); vuoto = nessuna cattura.
# Con la scheda USB della radio per esempio: USB Audio
AURORA_AUDIO_DEVICE=
# Per quanti giorni ricordare i messaggi ricevuti nello storico (0 = per sempre)
AURORA_HISTORY_DAYS=30

# Con JTDX: 1 = all'avvio chiede a JTDX di rimandare i decode correnti (li ricevono di nuovo anche i programmi
# a valle, marcati "non nuovi"); 0 = non chiederli
AURORA_REPLAY_ON_CONNECT=0

# Paese e novita' (nuovo DXCC, nuova zona, nuova griglia) sui messaggi. Vuoto: nessuna etichetta.
# cty.dat di JTDX: <cartella di JTDX>/share/jtdx/cty.dat
AURORA_CTY_PATH=
# Log ADIF dei QSO gia' fatti (JTDX: %LOCALAPPDATA%/JTDX/wsjtx_log.adi)
AURORA_WORKED_ADIF=

# Comando della radio: none | omnirig (condiviso con JTDX) | hamlib (tutte le radio, tramite rigctld; si configura in Impostazioni → Radio CAT)
AURORA_RIG=none
# Percorso di rigctld (file o cartella) se non sta accanto ad Aurora; vedi docs/cat-radio.md
AURORA_RIGCTLD=
# JTDX.ini di JTDX (%LOCALAPPDATA%/JTDX/JTDX.ini): da qui Aurora legge e modifica le impostazioni del motore. Vuoto: pagine in sola vista non disponibili
AURORA_JTDX_INI=
# Database SQLite di Log4OM2 (Documenti/LOG4OM2/<nominativo>.sqlite), letto in sola lettura per la finestra Log. Vuoto: nessun log
AURORA_LOG4OM_DB=
# Registro dei QSO verso log esterni (ADIF su UDP, separati da virgola) e su file, con lo stesso record che JTDX manda al suo secondo server UDP.
# Con il motore proprio (JTDX non c'e') il programma Windows imposta AURORA_EXPORT_UDP da solo con il secondo server UDP di JTDX.ini
# (EnableUDP2adifBroadcast, UDP2Server, UDP2ServerPort: di norma 127.0.0.1:2237 = Log4OM2); qui lo si cambia o lo si toglie (valore vuoto = nessun invio).
# Con il motore JTDX non va impostato: sarebbe JTDX a mandarlo e il QSO arriverebbe due volte.
AURORA_EXPORT_UDP=
# Un secondo file ADIF oltre ad aurora_log.adi (cartella dei dati; col motore proprio si scrive sempre, nello stesso formato di wsjtx_log.adi di JTDX, che non si tocca)
AURORA_EXPORT_FILE=
# Potenza in watt scritta in TX_PWR di ogni QSO (vuoto = nessun TX_PWR, come JTDX con "Save Tx power" spento)
AURORA_TX_POWER=
# Salvaguardie dell'automazione
AURORA_AUTO_MAX_CYCLES=6
AURORA_AUTO_MAX_PER_DAY=40
AURORA_AUTO_DEAD_MAN_SECS=120
AURORA_AUTO_UNATTENDED=0

# Durata del codice di associazione in secondi (60-3600). Si cambia anche dalle impostazioni, solo dal PC.
AURORA_PAIR_TTL_SECS=600
# Accesso senza codice per le prove (solo rete di casa, mai da proxy): 0 o 1. Pericoloso se lasciato acceso.
AURORA_OPEN_ACCESS=0
# Chi arriva da questo stesso PC entra senza codice (mai da proxy o tunnel; il programma Windows lo accende da solo)
AURORA_TRUST_LOCAL=0
