# Server di Aurora
AURORA_BIND=127.0.0.1:8787
AURORA_DATA_DIR=data
# Cartella dell'interfaccia compilata (vuoto in sviluppo: la serve Vite)
AURORA_UI_DIR=
# Motore: "native" (il motore di Aurora sulla scheda audio; il programma Windows usa questo) oppure "sim" (stazione simulata, per le prove)
AURORA_ENGINE=sim
AURORA_SIM_CYCLE_MS=15000
# Cookie con attributo Secure: metti 1 quando si arriva in HTTPS (Tailscale serve, Cloudflare)
AURORA_SECURE_COOKIE=0

# Indirizzo locale di Aurora per il flusso UDP (valore iniziale delle impostazioni)
AURORA_UDP_LISTEN=127.0.0.1:2334
# A chi inoltrare il flusso identico, separati da virgole (GridTracker2 ascolta su 127.0.0.1:2333)
AURORA_UDP_FORWARD=127.0.0.1:2333

# AURORA_UDP_FORWARD e AURORA_EXPORT_UDP sono solo i valori iniziali: il primo indirizzo del forward diventa il server UDP
# primario, gli altri (e quelli di AURORA_EXPORT_UDP) i destinatari del riquadro «Integrazioni» (Impostazioni > Segnalazioni), dove si scelgono
# per ciascuno flusso WSJT-X, Logged ADIF, ADIF su UDP, XML di N1MM e multicast (TTL, interfaccia). Dopo la prima apertura vale quel riquadro.
# Aurora parla il protocollo UDP di WSJT-X con gli stessi destinatari di AURORA_UDP_FORWARD
# (GridTracker2, che a sua volta inoltra a Log4OM2): Heartbeat, Status (DX in chiamata), Decode, Clear, QSO Logged, Logged ADIF, Close.
# 0 lo spegne.
AURORA_UDP_EMIT=1
# Opzioni del primo server UDP: i comandi di GridTracker (Reply, HaltTx,
# FreeText, ...) arrivano ad Aurora solo con AURORA_UDP_ACCEPT=1; AURORA_UDP_ACCEPT_REPLY: 1 solo CQ, 2 CQ e 73, 3 tutti;
# AURORA_UDP_ADIF=1 manda anche il record ADIF dopo ogni QSO (EnableUDP1adifSending).
AURORA_UDP_ACCEPT=0
AURORA_UDP_ACCEPT_REPLY=1
AURORA_UDP_ADIF=0

# Cascata dall'ingresso audio (parte del nome, senza distinzione di maiuscole); vuoto = nessuna cattura.
# Con la scheda USB della radio per esempio: USB Audio
AURORA_AUDIO_DEVICE=
# Per quanti giorni ricordare i messaggi ricevuti nello storico (0 = per sempre)
AURORA_HISTORY_DAYS=30

# Paese e novita' (nuovo DXCC, nuova zona, nuova griglia) sui messaggi. Vuoto: nessuna etichetta.
# Il programma lo trova da solo (cty.dat incluso in Aurora); qui solo per indicarne un altro
AURORA_CTY_PATH=
# Un log ADIF in piu' con i QSO gia' fatti (facoltativo: Aurora usa gia' il suo log)
AURORA_WORKED_ADIF=

# Comando della radio: none | omnirig (driver OmniRig, solo Windows) | hamlib (tutte le radio, tramite rigctld; si configura in Impostazioni → Radio CAT)
AURORA_RIG=none
# Percorso di rigctld (file o cartella) se non sta accanto ad Aurora; vedi docs/cat-radio.md
AURORA_RIGCTLD=
# Database SQLite di Log4OM2 (Documenti/LOG4OM2/<nominativo>.sqlite), letto in sola lettura per la finestra Log. Vuoto: nessun log
AURORA_LOG4OM_DB=
# Destinatari in piu' dei QSO come ADIF su UDP, separati da virgola (per esempio Log4OM2 su 127.0.0.1:2237); di norma si sceglie in Impostazioni.
AURORA_EXPORT_UDP=
# Un secondo file ADIF oltre ad aurora_log.adi (cartella dei dati, che si scrive sempre)
AURORA_EXPORT_FILE=
# Potenza in watt scritta in TX_PWR di ogni QSO (vuoto = nessun TX_PWR)
AURORA_TX_POWER=
# Salvaguardie dell'automazione
AURORA_AUTO_MAX_CYCLES=6
AURORA_AUTO_MAX_PER_DAY=40
AURORA_AUTO_DEAD_MAN_SECS=120
AURORA_AUTO_UNATTENDED=0

# Durata del codice di associazione in secondi (60-3600). Si cambia anche dalle impostazioni, solo dal PC.
AURORA_PAIR_TTL_SECS=600
# Accesso senza codice per le prove (solo rete di casa, mai da proxy): 0 o 1. Pericoloso se lasciato acceso.
AURORA_OPEN_ACCESS=0
# Chi arriva da questo stesso PC entra senza codice (mai da proxy o tunnel; il programma Windows lo accende da solo)
AURORA_TRUST_LOCAL=0

# ALL.TXT: l interruttore e nelle impostazioni (Segnalazioni); AURORA_ALL_TXT=0 resta come spegnimento di emergenza di tutta la scrittura
# AURORA_ALL_TXT=0
